<!DOCTYPE html>
<html>
  <head>
    <title>DormDish</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Optional: Bootstrap Icons for small UI polish -->
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  </head>

  <body class="bg-body">
    <nav class="navbar navbar-expand-lg navbar-dorm">
      <div class="container">
        <%= link_to "DormDish", root_path, class: "navbar-brand fw-bold" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
          <% if current_profile %>
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
              <li class="nav-item"><%= link_to "Recipes", recipes_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Meal Plan", meal_plans_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Shopping List", shopping_list_path, class: "nav-link" %></li>
              <li class="nav-item">
                <%= link_to user_profile_path(current_profile), class: "btn btn-pill btn-primary-subtle" do %>
                  <i class="bi bi-person-circle me-1"></i> Profile
                <% end %>
              </li>
            </ul>
          <% else %>
            <% unless current_page?(root_path) %>
              <div class="ms-auto">
                <%= link_to "Get Started", new_user_profile_path, class: "btn btn-pill btn-primary" %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </nav>

    <header class="hero-gradient">
      <div class="container py-4">
        <%= yield :page_header %>
      </div>
    </header>

    <main class="container py-4">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="container d-flex flex-column flex-md-row align-items-center gap-2 justify-content-between">
        <span class="text-muted">&copy; <%= Time.current.year %> DormDish</span>
        <span class="small text-muted">Built with Rails, Bootstrap, and lots of snacks 🍪</span>
      </div>
    </footer>
  </body>
</html>