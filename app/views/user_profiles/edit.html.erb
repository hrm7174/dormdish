<% content_for :page_header do %>
    <h1 class="h3 mb-0">Edit Your Profile</h1>
  <% end %>
  
  <div class="row justify-content-center mt-3">
    <div class="col-md-7 col-lg-6">
      <div class="card">
        <div class="card-body">
          <h2 class="h4 mb-3">Update your setup</h2>
  
          <%= form_with model: @user_profile, url: user_profile_path(@user_profile), method: :patch, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :name, "Your Name", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "e.g. Heidy" %>
            </div>
  
            <div class="mb-3">
              <%= f.label :weekly_budget, "Weekly Budget ($)", class: "form-label" %>
              <%= f.number_field :weekly_budget, step: 0.5, class: "form-control", placeholder: "e.g. 30" %>
            </div>
  
            <div class="mb-3">
              <%= f.label :appliances, "Available Appliances", class: "form-label" %>
              <%= f.select :appliances, 
                  options_for_select([
                    ["Microwave", "Microwave"],
                    ["Mini Fridge", "Mini Fridge"],
                    ["Hot Plate", "Hot Plate"],
                    ["None", "None"]
                  ], @user_profile.appliances),
                  {}, 
                  { multiple: true, class: "form-select" } %>
              <small class="form-text text-muted">Hold ⌘ (Mac) or Ctrl (Windows) to select multiple.</small>
            </div>
  
            <div class="mb-3">
              <%= f.label :dietary_preferences, "Dietary Preferences", class: "form-label" %>
              <%= f.select :dietary_preferences,
                  options_for_select([
                    ["None", "None"],
                    ["Vegetarian", "Vegetarian"],
                    ["Vegan", "Vegan"],
                    ["Gluten-Free", "Gluten-Free"],
                    ["Dairy-Free", "Dairy-Free"]
                  ], @user_profile.dietary_preferences),
                  {},
                  { multiple: true, class: "form-select" } %>
            </div>
  
            <div class="d-grid gap-2 mt-4">
              <%= f.submit "Update Profile", class: "btn btn-primary btn-pill" %>
              <%= link_to "Cancel", user_profile_path(@user_profile), class: "btn btn-outline-secondary btn-pill" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>