<% content_for :page_header do %>
    <h1 class="h3 mb-0">My Profile</h1>
  <% end %>
  
  <div class="container">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title mb-4">Profile Details</h5>
            
            <div class="mb-3">
              <label class="form-label text-muted">Name</label>
              <p class="h6"><%= @user_profile.name %></p>
            </div>
  
            <div class="mb-3">
              <label class="form-label text-muted">Weekly Budget</label>
              <p class="h6">$<%= number_with_precision(@user_profile.weekly_budget, precision: 2) %></p>
            </div>
  
            <div class="mb-3">
              <label class="form-label text-muted">Available Appliances</label>
              <% if @user_profile.appliances.present? %>
                <div class="d-flex flex-wrap gap-2">
                  <% @user_profile.appliances.each do |appliance| %>
                    <span class="badge bg-primary"><%= appliance %></span>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted">No appliances were specified.</p>
              <% end %>
            </div>
  
            <div class="mb-3">
              <label class="form-label text-muted">Dietary Preferences</label>
              <% if @user_profile.dietary_preferences.present? %>
                <div class="d-flex flex-wrap gap-2">
                  <% @user_profile.dietary_preferences.each do |preference| %>
                    <span class="badge" style="background-color: #270078; color: white;"><%= preference %></span>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted">No dietary preferences were specified.</p>
              <% end %>
            </div>
  
            <div class="d-flex gap-2 mt-4">
              <%= link_to "Edit Profile", edit_user_profile_path(@user_profile), class: "btn btn-primary btn-pill" %>
              <%= link_to "View Meal Plans", meal_plans_path, class: "btn btn-outline-secondary btn-pill" %>
              <%= link_to "Browse Recipes", recipes_path, class: "btn btn-outline-secondary btn-pill" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>