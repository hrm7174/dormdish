<% content_for :page_header do %>
  <h1 class="h3 mb-0">My Profile</h1>
<% end %>

<div class="container">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <!-- Profile Details Card -->
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title mb-4">Profile Details</h5>
          
          <div class="mb-3">
            <label class="form-label text-muted">Name</label>
            <p class="h6"><%= @user_profile.name %></p>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted">Weekly Budget</label>
            <p class="h6">$<%= number_with_precision(@user_profile.weekly_budget, precision: 2) %></p>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted">Available Appliances</label>
            <% if @user_profile.appliances.present? %>
              <div class="d-flex flex-wrap gap-2">
                <% @user_profile.appliances.each do |appliance| %>
                  <span class="badge bg-primary"><%= appliance %></span>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted">No appliances were specified.</p>
            <% end %>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted">Dietary Preferences</label>
            <% if @user_profile.dietary_preferences.present? %>
              <div class="d-flex flex-wrap gap-2">
                <% @user_profile.dietary_preferences.each do |preference| %>
                  <span class="badge" style="background-color: #270078; color: white;"><%= preference %></span>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted">No dietary preferences were specified.</p>
            <% end %>
          </div>

          <div class="d-flex gap-2 mt-4">
            <%= link_to "Edit Profile", edit_user_profile_path(@user_profile), class: "btn btn-primary btn-pill" %>
            <%= link_to "View Meal Plans", meal_plans_path, class: "btn btn-outline-secondary btn-pill" %>
            <%= link_to "Browse Recipes", recipes_path, class: "btn btn-outline-secondary btn-pill" %>
          </div>
        </div>
      </div>

      <!-- NEW: Profile Statistics Card -->
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title mb-3">Profile Statistics</h5>
          
          <div class="row text-center">
            <div class="col-4">
              <div class="stat-box p-3">
                <h3 class="mb-1 text-primary"><%= @user_profile.meal_plans.count %></h3>
                <p class="text-muted small mb-0">Planned Meals</p>
              </div>
            </div>
            <div class="col-4">
              <div class="stat-box p-3">
                <h3 class="mb-1 text-primary"><%= @user_profile.shopping_lists.count %></h3>
                <p class="text-muted small mb-0">Shopping Lists</p>
              </div>
            </div>
            <div class="col-4">
              <div class="stat-box p-3">
                <h3 class="mb-1 text-primary"><%= @user_profile.recipes.distinct.count %></h3>
                <p class="text-muted small mb-0">Unique Recipes</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- NEW: Danger Zone Card -->
      <div class="card border-danger">
        <div class="card-header bg-danger text-white">
          <h5 class="mb-0">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Danger Zone
          </h5>
        </div>
        <div class="card-body">
          <h6 class="card-title">Delete Profile</h6>
          <p class="card-text text-muted">
            Permanently delete this profile and all associated data. This action cannot be undone.
          </p>
          
          <div class="alert alert-warning mb-3">
            <strong>⚠️ This will permanently delete:</strong>
            <ul class="mb-0 mt-2">
              <li><strong><%= @user_profile.meal_plans.count %></strong> meal plan entries</li>
              <li><strong><%= @user_profile.shopping_lists.count %></strong> shopping lists</li>
              <li>All profile preferences and settings</li>
            </ul>
          </div>
          
          <%= button_to "Delete Profile Permanently", 
              user_profile_path(@user_profile), 
              method: :delete,
              class: "btn btn-danger",
              onclick: "return confirm('⚠️ WARNING: Are you absolutely sure?\\n\\nThis will PERMANENTLY delete your profile \\'#{@user_profile.name}\\' and:\\n• #{@user_profile.meal_plans.count} meal plan entries\\n• #{@user_profile.shopping_lists.count} shopping lists\\n• All your saved preferences\\n\\nThis action CANNOT be undone!\\n\\nClick OK to delete or Cancel to keep your profile.');" %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .stat-box h3 {
    font-weight: 600;
  }
</style>