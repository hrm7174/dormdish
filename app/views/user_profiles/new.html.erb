<% content_for :page_header do %>
  <h1 class="h3 mb-0">Create Your DormDish Profile</h1>
<% end %>

<div class="row justify-content-center mt-3">
  <div class="col-md-7 col-lg-6">
    <div class="card">
      <div class="card-body">
        <h2 class="h4 mb-3">Tell us a bit about your setup</h2>

        <%= form_with(model: @user_profile, local: true) do |f| %>
          <% if @user_profile.errors.any? %>
            <div class="alert alert-danger alert-soft">
              <strong><%= pluralize(@user_profile.errors.count, "error") %> prevented saving:</strong>
              <ul class="mb-0">
                <% @user_profile.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :name, "Your Name", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "e.g. Heidy" %>
          </div>

          <div class="mb-3">
            <%= f.label :weekly_budget, "Weekly Budget ($)", class: "form-label" %>
            <%= f.number_field :weekly_budget, step: 0.5, class: "form-control", placeholder: "e.g. 30" %>
          </div>

          <div class="mb-3">
            <%= f.label :available_appliances, "Available Appliances", class: "form-label" %>
            <%= f.select :available_appliances, ["Microwave", "Mini Fridge", "Hot Plate", "None"], {}, multiple: true, class: "form-select" %>
            <small class="form-text text-muted">Hold ⌘ (Mac) or Ctrl (Windows) to select multiple.</small>
          </div>

          <div class="mb-3">
            <%= f.label :dietary_preferences, "Dietary Preferences", class: "form-label" %>
            <%= f.select :dietary_preferences, ["None", "Vegetarian", "Vegan", "Gluten-Free", "Dairy-Free"], {}, multiple: true, class: "form-select" %>
          </div>

          <div class="d-grid mt-4">
            <%= f.submit "Save Profile", class: "btn btn-primary btn-pill" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>