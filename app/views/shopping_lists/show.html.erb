<% content_for :page_header do %>
  <h1 class="h3 mb-0">Shopping List</h1>
<% end %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Ingredients Needed</h5>
        <% if @items.any? %>
          <ul class="list-group">
            <% @items.each do |item| %>
              <li class="list-group-item">
                <div class="form-check">
                  <input class="form-check-input list-check" type="checkbox" id="item-<%= item.parameterize %>">
                  <label class="form-check-label" for="item-<%= item.parameterize %>"><%= item %></label>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mb-0">No items yet. Add meals to your plan first.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card position-sticky" style="top: 1rem;">
      <div class="card-body">
        <h5 class="card-title">Summary</h5>
        <p class="mb-1"><strong>Total Items:</strong> <span id="total-items"><%= @items.count %></span></p>
        <p class="mb-3"><strong>Purchased:</strong> <span id="checked-count">0</span></p>
        <p class="mb-3"><strong>Estimated total:</strong> $<%= number_with_precision(@total_cost, precision: 2) %></p>
        <%= link_to "Back to Meal Plan", meal_plans_path, class: "btn btn-primary btn-pill w-100" %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const checks = document.querySelectorAll(".list-check");
    const out = document.getElementById("checked-count");
    const update = () => { out.textContent = [...checks].filter(c => c.checked).length; };
    checks.forEach(c => c.addEventListener("change", update));
    update();
  });
  document.addEventListener("DOMContentLoaded", function(){ // non-turbo fallback
    const event = new Event("turbo:load"); document.dispatchEvent(event);
  });
</script>
