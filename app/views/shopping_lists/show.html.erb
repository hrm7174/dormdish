<h2>Your Shopping List</h2>

<ul class="list-group">
  <% @shopping_list.items.each do |item| %>
    <li class="list-group-item">
      <input type="checkbox" class="form-check-input me-2"> <%= item %>
    </li>
  <% end %>
</ul>

<p id="purchased-summary"><strong>0 items purchased</strong></p>

<script>
  (function() {
    function updateCount() {
      var boxes = document.querySelectorAll('.list-group-item .form-check-input');
      var count = Array.prototype.filter.call(boxes, function(b){ return b.checked; }).length;
      var el = document.getElementById('purchased-summary');
      if (el) el.textContent = count + " items purchased";
    }
    document.addEventListener('change', function(e) {
      if (e.target && e.target.classList.contains('form-check-input')) updateCount();
    });
    document.addEventListener('DOMContentLoaded', updateCount);
  })();
</script>
