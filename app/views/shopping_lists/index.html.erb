<% content_for :page_header do %>
  <h1 class="h3 mb-0">Shopping List</h1>
<% end %>

<div class="mb-3">
  <%= link_to "Back to Meal Plan", meal_plans_path, class: "btn btn-outline-secondary btn-pill" %>
</div>

<% if @recipes.any? %>
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: shopping_lists_path, method: :get, local: true, class: "row g-3 align-items-end" do |f| %>
        <div class="col-md-6">
          <label class="form-label">Filter by Recipe</label>
          <%= f.select :recipe_id,
              options_for_select([["All Recipes", ""]] + @recipes.map { |r| [r.name, r.id] }, params[:recipe_id]),
              {}, class: "form-select" %>
        </div>
        <div class="col-md-2 d-grid">
          <%= f.submit "Filter", class: "btn btn-primary btn-pill" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @items.present? %>
  <div class="card">
    <div class="card-body">
      <% if @selected_recipe %>
        <h5 class="card-title mb-3"><%= @selected_recipe.name %> Ingredients</h5>
      <% else %>
        <h5 class="card-title mb-3">All Ingredients</h5>
      <% end %>

      <ul class="list-group">
        <% @items.each do |item| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong><%= item["name"] %></strong>
              <% if item["recipes"].present? %>
                <small class="text-muted">
                  used in: <%= item["recipes"].join(", ") %>
                </small>
              <% end %>
            </div>

            <div class="d-flex gap-2">
              <%= button_to "Remove",
                destroy_item_shopping_list_path(@shopping_list, ingredient_name: item["name"]),
                method: :delete,
                class: "btn btn-sm btn-outline-danger",
                onclick: "return confirm('Are you sure you want to remove #{item["name"]} from your shopping list?');" %>

              <%= link_to "Purchase",
                search_products_path(ingredient: item["name"], shopping_list_id: @shopping_list.id),
                class: "btn btn-sm btn-outline-success" %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% else %>
  <div class="alert alert-info">
    No ingredients to show. Add recipes to your meal plan to generate a shopping list.
  </div>
<% end %>
