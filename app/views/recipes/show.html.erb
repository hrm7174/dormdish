<% content_for :page_header do %>
  <h1 class="h3 mb-0"><%= @recipe.name %></h1>
<% end %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge badge-meal"><%= @recipe.meal_type.capitalize %></span>
          <% @recipe.dietary_tags.each { |t| %><span class="badge badge-diet"><%= t %></span><% } %>
          <% @recipe.appliances_needed.each { |a| %><span class="badge badge-appliance"><%= a %></span><% } %>
        </div>
        <p class="small text-muted mb-0">ß
          <i class="bi bi-stopwatch me-1"></i><%= @recipe.prep_time %> minutes
          &nbsp;&middot;&nbsp;
          <i class="bi bi-cash-coin me-1"></i>$<%= number_with_precision(@recipe.cost, precision: 2) %>
        </p>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">Ingredients</h5>
        <ul class="mb-0">
          <% @recipe.ingredients_list.each do |ingredient| %>
            <li><%= ingredient %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <% if @recipe.instructions.present? %>
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Instructions</h5>
          <div class="text-muted"><%= simple_format(@recipe.instructions) %></div>
        </div>
      </div>
    <% end %>


    <div class="card" style="margin-top: 1rem; margin-bottom: 1rem;">
      <div class="card-body">
        <h5 class="card-title">Add to Meal Plan</h5>

        <%= form_with url: meal_plans_path, method: :post, local: true do |f| %>

          <%= hidden_field_tag :recipe_id, @recipe.id %>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Day</label>
              <%= select_tag :day,
                    options_for_select(["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]),
                    class: "form-select" %>
            </div>

            <div class="col-md-6">
              <label class="form-label">Meal Type</label>
              <%= select_tag :meal_type,
                    options_for_select(["Breakfast","Lunch","Dinner", "Snack"]),
                    class: "form-select" %>
            </div>

          </div> <!-- END row -->

          <div class="mt-3">
            <%= f.submit "Add to Meal Plan", class: "btn btn-primary btn-pill" %>
          </div>

        <% end %>
        
      </div>
    </div>


    <div class="mt-3">
      <%= link_to "Back to Recipes", recipes_path, class: "btn btn-outline-secondary btn-pill" %>
    </div>
  </div>
</div>
