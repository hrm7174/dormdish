<% content_for :page_header do %>
  <h1 class="h3 mb-0"><%= @recipe.name %></h1>
<% end %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge badge-meal"><%= @recipe.meal_type.capitalize %></span>
          <% @recipe.dietary_tags.each { |t| %><span class="badge badge-diet"><%= t %></span><% } %>
          <% @recipe.appliances_needed.each { |a| %><span class="badge badge-appliance"><%= a %></span><% } %>
        </div>
        <p class="small text-muted mb-0">
          <i class="bi bi-stopwatch me-1"></i><%= @recipe.prep_time %> minutes
          &nbsp;&middot;&nbsp;
          <i class="bi bi-cash-coin me-1"></i>$<%= number_with_precision(@recipe.cost, precision: 2) %>
        </p>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">Ingredients</h5>
        <ul class="mb-0">
          <% @recipe.ingredients_list.each { |i| %><li><%= i %></li><% } %>
        </ul>
      </div>
    </div>

    <% if @recipe.instructions.present? %>
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Instructions</h5>
          <div class="text-muted"><%= simple_format(@recipe.instructions) %></div>
        </div>
      </div>
    <% end %>

    <div class="mt-3">
      <%= link_to "Back to Recipes", recipes_path, class: "btn btn-outline-secondary btn-pill" %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Add to Meal Plan</h5>
        <%= form_with model: @meal_plan, url: meal_plans_path, local: true do |f| %>
          <%= f.hidden_field :recipe_id, value: @recipe.id %>

          <div class="mb-3">
            <%= f.label :day, class: "form-label" %>
            <%= f.select :day, options_for_select(%w[Monday Tuesday Wednesday Thursday Friday Saturday Sunday]), {}, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :meal_type, "Meal", class: "form-label" %>
            <%= f.select :meal_type, options_for_select([["Breakfast","breakfast"],["Lunch","lunch"],["Dinner","dinner"],["Snack","snack"]]), {}, class: "form-select" %>
          </div>

          <%= f.submit "Add to Meal Plan", class: "btn btn-success btn-pill w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
