
<% content_for :page_header do %>
  <h1 class="h3 mb-0">Browse Recipes</h1>
<% end %>

<div class="mb-3">
  <%= link_to "Add A Recipe", new_recipe_path, class: "btn btn-primary btn-pill" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <%= form_with url: recipes_path, method: :get, local: true, class: "row g-3 align-items-end" do |f| %>
      <div class="col-md-4">
        <label class="form-label">Search</label>
        <%= f.text_field :search, placeholder: "Overnight oats, burrito…", class: "form-control", value: params[:search] %>
      </div>
      <div class="col-md-3">
        <label class="form-label">Meal Type</label>
        <%= f.select :meal_type,
            options_for_select([["All Meals", ""], ["Breakfast", "breakfast"], ["Lunch", "lunch"], ["Dinner", "dinner"], ["Snack", "snack"]], params[:meal_type]),
            {}, class: "form-select" %>
      </div>
      <div class="col-md-3">
        <label class="form-label">Max Cost ($)</label>
        <%= f.number_field :max_cost, step: 0.01, class: "form-control", value: params[:max_cost] %>
      </div>
      <div class="col-md-2 d-grid">
        <%= f.submit "Filter", class: "btn btn-primary btn-pill" %>
        <%= link_to "Reset", recipes_path, class: "btn btn-outline-secondary btn-pill mt-2" %>
      </div>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <% if @recipes.any? %>
    <% @recipes.each do |recipe| %>
      <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <h5 class="card-title mb-0"><%= recipe.name %></h5>
              <span class="badge badge-meal"><%= recipe.meal_type.capitalize %></span>
            </div>
            <p class="small text-muted mb-2">
              <i class="bi bi-stopwatch me-1"></i><%= recipe.prep_time %> min
              &nbsp;&middot;&nbsp;
              <i class="bi bi-cash-coin me-1"></i>$<%= number_with_precision(recipe.cost, precision: 2) %>
            </p>
            <div class="mb-2">
              <% recipe.dietary_tags.each do |tag| %>
                <span class="badge badge-diet me-1"><%= tag %></span>
              <% end %>
              <% if recipe.appliances_needed.present? %>
                <% recipe.appliances_needed.each do |a| %>
                  <span class="badge badge-appliance me-1"><%= a %></span>
                <% end %>
              <% end %>
            </div>
            <div class="mt-auto">
              <%= link_to "View Recipe", recipe_path(recipe), class: "btn btn-sm btn-primary btn-pill w-100" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="col-12">
      <div class="alert alert-info alert-soft">
        No recipes matched your filters. Try widening your search or updating your profile appliances/diet.
      </div>
    </div>
  <% end %>
</div>
