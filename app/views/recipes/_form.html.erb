<%= form_with model: recipe, local: true do |f| %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="row g-3">
    <div class="col-md-4">
      <%= f.label :meal_type, class: "form-label" %>
      <%= f.select :meal_type, ["Breakfast","Lunch","Dinner","Snack"], {}, class: "form-select" %>
    </div>

    <div class="col-md-4">
      <%= f.label :prep_time, "Prep Time (min)", class: "form-label" %>
      <%= f.number_field :prep_time, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= f.label :cost, "Cost ($)", class: "form-label" %>
      <%= f.number_field :cost, step: 0.01, class: "form-control" %>
    </div>
  </div>

  <div class="mt-3">
    <%= f.label :ingredients, "Ingredients (one per line)", class: "form-label" %>
    <%= f.text_area :ingredients, rows: 5, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= f.label :instructions, class: "form-label" %>
    <%= f.text_area :instructions, rows: 6, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= f.label :dietary_tags, "Dietary Tags", class: "form-label" %>
    <%= f.select :dietary_tags,
        ["Vegetarian", "Vegan", "Gluten-Free", "None"],
        { include_blank: "Select dietary tag(s)" },
        class: "form-select",
        multiple: true %>
  </div>

  <div class="mt-3">
    <%= f.label :appliances_needed, "Appliances Needed", class: "form-label" %>
    <%= f.select :appliances_needed,
       ["Microwave", "Mini-Fridge", "Hot Plate", "None"],
       { include_blank: "Select appliance(s)" },
       class: "form-select",
       multiple: true %>
  </div>

  <div class="mt-3">
    <%= f.submit "Save Recipe", class: "btn btn-primary btn-pill" %>
  </div>

<% end %>
