<% content_for :page_header do %>
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <h1 class="display-5 mb-2 fw-bold">Dorm-friendly meal planning</h1>
      <p class="lead text-muted mb-0">Plan, budget, and cook with just a microwave or mini fridge.</p>
    </div>
    <div class="d-none d-md-block">
      <%= link_to "Get Started", new_user_profile_path, class: "btn btn-lg btn-pill btn-primary" %>
    </div>
  </div>
<% end %>

<div class="row g-4 mt-1">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-piggy-bank me-2"></i>Budget-Friendly</h5>
        <p class="text-muted mb-0">Set a weekly budget and only see recipes that fit your wallet.</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-lightning-charge me-2"></i>Dorm-Safe</h5>
        <p class="text-muted mb-0">Filter by the appliances you actually have — microwave, hot plate, or none.</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-heart me-2"></i>Diet-Aware</h5>
        <p class="text-muted mb-0">Vegetarian, vegan, gluten-free? We’ve got you covered.</p>
      </div>
    </div>
  </div>
</div>

<div class="text-center my-5 d-md-none">
  <%= link_to "Get Started", new_user_profile_path, class: "btn btn-lg btn-pill btn-primary" %>
</div>
